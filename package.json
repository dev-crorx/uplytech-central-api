    "@types/passport-spotify": "^2.0.4",
    "@types/passport-twitter": "^1.0.40",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.5.13",
    "@typescript-eslint/eslint-plugin": "^8.14.0",
    "@typescript-eslint/parser": "^8.14.0",
    "eslint": "^10.8.0",
    "jest": "^30.4.2",
    "prettier": "^3.9.6",
    "prisma": "^5.22.0",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^7.0.2"
